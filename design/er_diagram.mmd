erDiagram

    transcripts {
        INT id PK
        VARCHAR_255 filename "NOT NULL e.g. Transcript_1_France.txt (partial UNIQUE WHERE is_active)"
        VARCHAR_255 expert_name "NOT NULL e.g. Dr. Jean Martin"
        VARCHAR_255 expert_role "NULL e.g. Head of Urology"
        VARCHAR_100 market "NOT NULL e.g. France"
        INT chunk_count "NULL DEFAULT 0"
        BOOLEAN is_active "NOT NULL DEFAULT TRUE (soft delete / version flag)"
        INT version "NOT NULL DEFAULT 1 (increments per filename on re-upload)"
        TIMESTAMP ingested_at "NULL DEFAULT NOW()"
    }

    chunks {
        INT id PK
        INT transcript_id FK "NOT NULL refs transcripts"
        VARCHAR_50 speaker "NOT NULL CHECK (Interviewer, Expert)"
        VARCHAR_10 speaker_index "NOT NULL e.g. IN_00, EX_01 (call order)"
        VARCHAR_10 timestamp "NOT NULL e.g. 00:18"
        TEXT content "NOT NULL bundled Q: question + A: answer"
        VECTOR_384 embedding "NOT NULL pgvector cosine (bundled Q+A text)"
        VECTOR_384 question_embedding "NOT NULL pgvector cosine (interviewer question only - guide Q<->Q matching)"
        TIMESTAMP created_at "NULL DEFAULT NOW()"
    }

    transcripts ||--o{ chunks : "contains"