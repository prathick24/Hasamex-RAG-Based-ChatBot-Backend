erDiagram

    transcripts {
        INT id PK
        VARCHAR_255 filename "NOT NULL UNIQUE e.g. Transcript_1_France.txt"
        VARCHAR_255 expert_name "NOT NULL e.g. Dr. Jean Martin"
        VARCHAR_255 expert_role "NULL e.g. Head of Urology"
        VARCHAR_100 market "NOT NULL e.g. France"
        INT chunk_count "NULL DEFAULT 0"
        TIMESTAMP ingested_at "NULL DEFAULT NOW()"
    }

    chunks {
        INT id PK
        INT transcript_id FK "NOT NULL refs transcripts"
        VARCHAR_50 speaker "NOT NULL CHECK (Interviewer, Expert)"
        VARCHAR_10 speaker_index "NOT NULL e.g. IN_00, EX_01 (call order)"
        VARCHAR_10 timestamp "NOT NULL e.g. 00:18"
        TEXT content "NOT NULL"
        VECTOR_384 embedding "NOT NULL pgvector cosine"
        TIMESTAMP created_at "NULL DEFAULT NOW()"
    }

    transcripts ||--o{ chunks : "contains"