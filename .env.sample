# PostgreSQL connection (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:Admin123@localhost:5432/hasamex

# Groq LLM API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional overrides
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# TOP_K=5
# SIMILARITY_THRESHOLD=0.25
# LOG_LEVEL=INFO
# CACHE_LLM_RESULTS=true